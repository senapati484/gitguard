# ─────────────────────────────────────────────
# GitGuard — Environment Variable Reference
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local or secrets to version control.
# ─────────────────────────────────────────────

# ─── GitHub App ──────────────────────────────
# GitHub App numeric ID (found in App settings)
GITHUB_APP_ID=

# GitHub App private key — paste the full PEM including header/footer,
# or store it as a single-line string with \n line separators.
# To generate: openssl genrsa -out private-key.pem 2048
GITHUB_APP_PRIVATE_KEY=

# Secret used to verify incoming webhook payloads from GitHub.
# Generate a secure random value: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Slug of your GitHub App (the URL-friendly name shown in https://github.com/apps/<slug>)
# Used by /install to build the install URL: https://github.com/apps/<slug>/installations/new
NEXT_PUBLIC_GITHUB_APP_SLUG=

# (Optional) OAuth app credentials for user-facing GitHub login
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── Firebase ────────────────────────────────
# Firebase project config (client-side — safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side — KEEP SECRET)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Upstash Redis ───────────────────────────
# Connection URL from your Upstash console (includes auth token)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── App ─────────────────────────────────────
# Base URL of the deployed app (used for webhook callback URLs, OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# ─── Security Agents & LLM ───────────────────
# Primary AI: Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback AI: Google Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=

# Optional custom path to gitleaks binary if not in standard PATH
GITLEAKS_PATH=
